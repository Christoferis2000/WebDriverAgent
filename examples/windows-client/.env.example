# Skopiruj tento subor a nastav hodnoty ako premenne prostredia pred spustenim.
# test.mjs .env NEnacitava automaticky - nastav premenne v shelli.
#
# PowerShell (Windows):
#   $env:APPIUM_URL = "http://192.168.1.50:4723"
#   node test.mjs
#
# CMD (Windows):
#   set APPIUM_URL=http://192.168.1.50:4723 && node test.mjs

# --- Spolocne ----------------------------------------------------------------
# Plna URL Appium/WDA endpointu.
#   Cesta B (Mac v lokalnej sieti): http://<IP-Macu>:4723
#   Cesta A (BrowserStack):         https://hub-cloud.browserstack.com/wd/hub
APPIUM_URL=http://127.0.0.1:4723

# Ake zariadenie a appka.
DEVICE_NAME=iPhone 15
PLATFORM_VERSION=17.0
BUNDLE_ID=com.apple.Preferences

# --- BEZPECNOST --------------------------------------------------------------
# Realne zariadenie ide VZDY cez USB (klient na 127.0.0.1) - to je primarna izolacia.
# WDA_BINDING_IP je DOPLNKOVY zamok: 127.0.0.1 = WDA sa na zariadeni bindne len na
# loopback -> nie je vidno na WiFi (port 8100). WDA nema auth ani TLS, preto sa to
# oplati. Pozn.: XCUITest docs ho znacia ako simulatorovy, v kode WDA funguje aj na
# realnom zariadeni - over si to (z ineho stroja nesmie ist http://<WiFi-IP>:8100/status).
# Prazdne = bind na vsetky rozhrania (0.0.0.0) = vystavene do siete - neodporuca sa.
WDA_BINDING_IP=127.0.0.1

# --- Cesta A (cloud device farm) - inak nechaj prazdne -----------------------
CLOUD_USER=
CLOUD_KEY=
